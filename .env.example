# Qodana Cloud token (Ultimate Plus). Get from https://qodana.cloud
# Project Settings -> Tokens -> Generate
QODANA_TOKEN=

# Optional private npm mirror, read only by z-ram.sh. Leave both empty (or delete them) to use registry.npmjs.org.
# Yarn 4 refuses http:// unless the host is in the whitelist.
YARN_NPM_REGISTRY_SERVER=
YARN_UNSAFE_HTTP_WHITELIST=
