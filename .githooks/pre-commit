#!/usr/bin/env bash
#
# koa-utils — pre-commit gates: yarn.lock registry, 100% coverage, Qodana.
#
# Enforces the same bars as CI, before the commit rather than after the push.
# Thresholds live elsewhere — .c8rc.json ("check-coverage": true, "per-file":
# true, all metrics at 100) and qodana.yaml (critical 0 / high 0, coverage
# 100/100). This hook only decides *when* to run them, never *how strict*.
#
# Wired via `git config core.hooksPath .githooks`, done by `yarn hooks:install`
# (also run automatically by the `prepare` script on `yarn install`).
#
# Bypass: `git commit --no-verify` (CI still gates — the bypass is local only).
# Qodana only: `SKIP_QODANA=1 git commit`.
#
# Caveat: the suite runs against the working tree, not the staged snapshot. If
# unstaged edits are in flight, what is tested is not exactly what is committed.
# Deliberate: stashing inside a hook risks losing work when the hook fails.

set -euo pipefail

# Only code, test or build-config changes can move coverage. Docs-only commits skip.
RELEVANT_PATHS='^(src/|test/|package\.json$|\.c8rc\.json$|\.mocharc\.json$|tsconfig.*\.json$)'

# Deletions count: removing a spec file lowers coverage just as surely as adding
# untested code, so D stays in the filter.
STAGED="$(git diff --cached --name-only --diff-filter=ACMRD)"

# Backstop for the yarn.lock clean filter (scripts/lockfile-registry-filter.sh).
# The filter normally strips the local proxy host on its way into the index; if
# it was never configured, the committed lockfile carries a LAN-only registry
# that breaks `yarn install` for every other clone.
#
# Inspect the index (`:yarn.lock`), not the working tree — the working tree
# keeps proxy URLs by design. Checked unconditionally rather than only when
# yarn.lock is staged: a proxy-tainted blob that happens to match HEAD produces
# no staged diff, so a $STAGED-gated check would wave through exactly the state
# it exists to catch. Absent from the index, `git show` fails and LOCK_INDEX is
# empty.
#
# Read into a variable instead of piping `git show` into `grep -q`: -q exits on
# the first match, `git show` then dies of SIGPIPE, and `set -o pipefail` turns
# that into a falsy pipeline — the check would silently never fire.
LOCK_INDEX="$(git show :yarn.lock 2> /dev/null || true)"

# Match on "not the public registry" rather than one hard-coded proxy host, so
# any mirror, VPN-only cache or rewritten uplink is caught too.
FOREIGN_HOSTS="$(
	printf '%s\n' "$LOCK_INDEX" \
		| grep -oE '^[[:space:]]*resolved "https?://[^/"]+' \
		| grep -oE 'https?://[^/"]+' \
		| grep -vxF 'https://registry.npmjs.org' \
		| sort -u \
		|| true
)"

if [ -n "$FOREIGN_HOSTS" ]; then
	cat >&2 << EOF

pre-commit: BLOCKED — yarn.lock in the index resolves against a non-public registry:

$(printf '%s\n' "$FOREIGN_HOSTS" | sed 's/^/    /')

Every \`resolved\` URL must use https://registry.npmjs.org/ in git, or clones
without access to that host cannot install. The clean filter does this
automatically — it is probably just not configured in this clone:

    yarn hooks:install        # or: ./scripts/lockfile-registry-filter.sh install
    touch yarn.lock && git add yarn.lock

EOF
	exit 1
fi

if [ -z "$STAGED" ]; then
	exit 0
fi

if ! printf '%s\n' "$STAGED" | grep -Eq "$RELEVANT_PATHS"; then
	echo "pre-commit: no code/test/build-config changes staged — coverage gate skipped."
	exit 0
fi

if ! command -v yarn > /dev/null 2>&1; then
	echo "pre-commit: yarn not found in PATH — cannot run the coverage gate." >&2
	echo "            Install yarn, or bypass once with: git commit --no-verify" >&2
	exit 1
fi

echo "pre-commit: running build + tests + 100% coverage gate (yarn test:coverage)…"

if ! yarn test:coverage; then
	cat >&2 << 'EOF'

pre-commit: BLOCKED — build, tests, or the 100% coverage threshold failed.

Coverage below 100% on any file fails the commit (.c8rc.json: per-file, all
metrics at 100). Add tests under test/ mirroring the src/ layout until the c8
summary reports 100% on statements, branches, functions and lines.

Full report: .qodana/code-coverage/lcov-report/index.html
Bypass once (CI will still block): git commit --no-verify
EOF
	exit 1
fi

echo "pre-commit: 100% coverage held."

# ---------------------------------------------------------------------------
# Qodana gate.
#
# CI runs Qodana on push to main (.github/workflows/qodana.yml), which is after
# `yarn upload` has already published. 5.6.0 shipped a defect that way: the scan
# went red about three minutes after the broken tarball was public. Running the
# same scan here moves the verdict in front of the commit.
#
# Reuses the coverage report `yarn test:coverage` just wrote to .qodana/ — this
# invokes docker directly rather than `yarn qodana`, which would re-run the
# whole suite a second time.
#
# Never pulls, and never skips. Those are two separate rules and both matter:
#
#   - No pull inside the hook. Auto-pulling is what broke the 5.6.1 CI run —
#     Docker Hub timed out, qodana-action fell through to --skip-pull, the
#     container never started, and the resulting "failure" carried no verdict
#     at all (156-byte empty report). A hook that pulls inherits that flake and
#     turns a network blip into a failed commit.
#
#   - A prerequisite that is missing blocks, it does not warn-and-continue. A
#     gate that silently steps aside when it cannot run is not a gate; it is
#     the exact hole this hook exists to close, reopened one condition lower.
#     So every check below prints the one command that fixes it and exits 1.
#
# Bypass: SKIP_QODANA=1 git commit
# ---------------------------------------------------------------------------

# $1 = what is wrong, $2… = the command(s) that fix it.
qodana_block() {
	local reason="$1"
	shift
	{
		echo
		echo "pre-commit: BLOCKED — Qodana gate cannot run: $reason"
		echo
		echo "Fix it with:"
		echo
		printf '    %s\n' "$@"
		echo
		echo "Bypass once (CI will still block): SKIP_QODANA=1 git commit"
		echo
	} >&2
	exit 1
}

if [ -n "${SKIP_QODANA:-}" ]; then
	echo "pre-commit: Qodana gate skipped — SKIP_QODANA is set. CI still scans on push to main." >&2
	exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"

if ! command -v docker > /dev/null 2>&1; then
	qodana_block "docker not found in PATH." \
		"# install Docker Engine, then re-run the commit:" \
		"https://docs.docker.com/engine/install/"
fi

if ! docker info > /dev/null 2>&1; then
	qodana_block "docker daemon not reachable." \
		"sudo systemctl start docker"
fi

if [ ! -f "$ROOT/qodana.yaml" ]; then
	qodana_block "qodana.yaml missing from the repo root." \
		"git checkout qodana.yaml"
fi

# Track the linter declared in qodana.yaml rather than hard-coding a tag here,
# so bumping the version in one place cannot leave the hook scanning with an
# older image than CI.
LINTER="$(grep -oE 'jetbrains/qodana-js:[0-9][0-9.]*' "$ROOT/qodana.yaml" | head -n 1 || true)"

if [ -z "$LINTER" ]; then
	qodana_block "no 'jetbrains/qodana-js:<version>' linter line found in qodana.yaml." \
		"# restore the 'linter:' key, then re-run the commit:" \
		"git checkout qodana.yaml"
fi

if [ ! -f "$ROOT/.env" ]; then
	qodana_block ".env missing — QODANA_TOKEN lives there, and Qodana 2023.2+ refuses to start without it." \
		"# get a project token from https://qodana.cloud, then:" \
		"echo 'QODANA_TOKEN=<token>' >> .env"
fi

if ! grep -q '^[[:space:]]*QODANA_TOKEN=' "$ROOT/.env"; then
	qodana_block "no QODANA_TOKEN in .env — Qodana 2023.2+ refuses to start without it." \
		"# get a project token from https://qodana.cloud, then:" \
		"echo 'QODANA_TOKEN=<token>' >> .env"
fi

# Pull is deliberately the developer's command, not the hook's — see the header.
# Blocking here costs one explicit fetch, once per image bump; auto-pulling
# would cost a failed commit every time Docker Hub is slow.
if ! docker image inspect "$LINTER" > /dev/null 2>&1; then
	qodana_block "linter image $LINTER not present locally." \
		"docker pull $LINTER"
fi

echo "pre-commit: running Qodana ($LINTER)…"

mkdir -p "$ROOT/.qodana/results"

if ! docker run --rm --env-file "$ROOT/.env" \
	-v "$ROOT":/data/project \
	-v "$ROOT/.qodana/results":/data/results \
	"$LINTER"; then
	cat >&2 << EOF

pre-commit: BLOCKED — Qodana failed.

Gate lives in qodana.yaml: severityThresholds critical 0 / high 0, and
testCoverageThresholds fresh 100 / total 100. Any critical or high finding
fails the commit.

Report: .qodana/results/report/index.html

Note this exit code also covers infrastructure failures (daemon died mid-scan,
out of disk). If the report shows no findings, it was not a finding.

Bypass once (CI will still block): SKIP_QODANA=1 git commit
EOF
	exit 1
fi

echo "pre-commit: Qodana clean. Proceeding with commit."
