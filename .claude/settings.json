{
	"permissions": {
		"deny": [
			"Read(./z-ram.sh)",
			"Edit(./z-ram.sh)",
			"Read(./.npmrc)",
			"Edit(./.npmrc)",
			"Read(./.yarnrc)",
			"Edit(./.yarnrc)",
			"Read(./yarnrc)",
			"Edit(./yarnrc)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Skill",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/scripts/caveman-claudemd-gate.sh\" mark",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/scripts/caveman-claudemd-gate.sh\" check",
						"timeout": 10,
						"statusMessage": "Rule 0 — CLAUDE.md caveman gate"
					}
				]
			}
		]
	}
}
